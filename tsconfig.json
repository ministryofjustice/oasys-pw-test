{
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "esnext",
            "dom"
        ],
        "rootDir": ".",
        "module": "commonjs",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "useDefineForClassFields": false,
        "strictNullChecks": false,
        "paths": {
            "*": [
                "./*"
            ],
        },
        "skipLibCheck": true
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules/**/.*",
        "playwright-report",
        "test-results",
        "archivedCypressCode"
    ],
    "typedocOptions": {
        "entryPointStrategy": "expand",
        "entryPoints": [
            "@types/**/*.ts",
            "classes/**/*.ts",
            "fixtures/**/*.ts",
            "lib/**/*.ts",
        ],
        "excludeExternals": true,
        "excludeReferences": true,
        "disableGit": true,
        "sourceLinkTemplate": "../../{path}",
        "router": "kind",
        "plugin": [
            "typedoc-plugin-missing-exports"
        ],
        "highlightLanguages": [
            "javascript",
            "json",
            "jsonc",
            "json5",
            "tsx",
            "typescript",
            "markdown"
        ]
    }
}